# === Supabase ===
# URL y anon key: Supabase Dashboard > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role key: SOLO para scripts server-side/CLI. Nunca exponer al cliente.
SUPABASE_SERVICE_ROLE_KEY=

# ID del proyecto, usado por `npm run db:types`
SUPABASE_PROJECT_ID=

# === App ===
NEXT_PUBLIC_SITE_URL=http://localhost:3000

